+class C3k2AmpF(C3k2):
+    """C3k2 followed by AmpMix on its output feature map (feature-level amplitude mixing, training only)."""
+
+    def __init__(self, c1, c2, n=1, c3k=False, e=0.5, attn=False, g=1, shortcut=True):
+        super().__init__(c1, c2, n, c3k, e, attn, g, shortcut)
+        self.am = AmpMixV2(clamp=False)
+
+    def forward(self, x):
