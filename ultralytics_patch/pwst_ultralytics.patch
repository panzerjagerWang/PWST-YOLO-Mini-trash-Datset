+class FeatGIN(nn.Module):
+    """Gated feature-level instance normalisation: y + a * (IN(y) - y), a per channel, a0 = 0 (identity at initialisation)."""
+
+    def __init__(self, c, a0=0.0, eps=1e-5):
+        super().__init__()
+        self.gate_bias = nn.Parameter(torch.full((c,), float(a0)))
+        self.eps = eps
+
+    def forward(self, y):
+        yf = y.float()
+        mu = yf.mean(dim=(2, 3), keepdim=True)
+        sd = (yf.var(dim=(2, 3), keepdim=True, unbiased=False) + self.eps).sqrt()
+        a = self.gate_bias.float().view(1, -1, 1, 1)
+        return (yf + a * ((yf - mu) / sd - yf)).to(y.dtype)
+
+
+class C3k2FIN(C3k2):
+    """C3k2 followed by a gated instance normalisation (IBN-style appearance invariance, identity at initialisation)."""
+
+    def __init__(self, c1, c2, n=1, c3k=False, e=0.5, attn=False, g=1, shortcut=True):
+        super().__init__(c1, c2, n, c3k, e, attn, g, shortcut)
+        self.fin = FeatGIN(c2, 0.0)
+
+    def forward(self, x):
+        return self.fin(super().forward(x))
+
+
+class C3k2LK(C3k2):
+    """C3k2 followed by a zero-gated 7x7 depthwise-convolution residual branch (large receptive field, control for capacity)."""
+
+    def __init__(self, c1, c2, n=1, c3k=False, e=0.5, attn=False, g=1, shortcut=True):
+        super().__init__(c1, c2, n, c3k, e, attn, g, shortcut)
+        self.dw = nn.Conv2d(c2, c2, 7, 1, 3, groups=c2, bias=False)
+        self.bn = nn.BatchNorm2d(c2)
+        self.gate_bias = nn.Parameter(torch.zeros(1))
+
+    def forward(self, x):
+        y = super().forward(x)
+        return y + self.gate_bias * self.bn(self.dw(y))
+
+
+class SpecGain(nn.Module):
+    """Phase-preserving spectral amplitude gain (a learned Wiener-like amplitude correction).
+
+    rfft2 -> amplitude A and phase P; A is multiplied by a per-channel gain that depends on the radial frequency (nb log-spaced bins) and is
+    modulated by the image's own radial energy profile; the phase P is untouched; irfft2.  The gain is exp(tanh(.)) so that
+    it is exactly 1 at initialisation (identity).  Blur by a centrally symmetric kernel (defocus, Gaussian) acts on the amplitude spectrum only,
+    which is what this module can undo; the phase carries the structure and is never altered."""
+
+    def __init__(self, c, nb=8):
+        super().__init__()
+        self.c, self.nb = c, nb
+        self.base_bias = nn.Parameter(torch.zeros(c * nb))
+        self.mod_w_bias = nn.Parameter(torch.zeros(nb, nb))
+        self.mod_b_bias = nn.Parameter(torch.zeros(nb))
+
+    def _bin_map(self, H, W, dev):
+        # radial-frequency bin of every rfft2 coefficient (computed on the device of the input, not cached: the module is deep-copied/moved by the trainer)
+        fy = torch.fft.fftfreq(H, device=dev).abs().view(H, 1)
+        fx = torch.fft.rfftfreq(W, device=dev).view(1, W // 2 + 1)
+        r = (fy ** 2 + fx ** 2).sqrt() / 0.7071        # 0 .. 1 (corner)
+        return (r.clamp(1e-6, 1.0).log2() * (self.nb / 7.0) + self.nb - 1).clamp(0, self.nb - 1).round().long()   # 7 octaves
+
+    def forward(self, x):
+        B, C, H, W = x.shape
+        dt = x.dtype
+        f = torch.fft.rfft2(x.float(), norm="ortho")
+        amp, pha = f.abs(), f.angle()
+        idx = self._bin_map(H, W, x.device)                      # (H, W/2+1)
+        la = torch.log1p(amp)                                     # (B, C, H, W/2+1)
+        prof = torch.zeros(B, self.nb, device=x.device)
+        cnt = torch.zeros(self.nb, device=x.device).scatter_add_(0, idx.flatten(), torch.ones(idx.numel(), device=x.device)).clamp_min(1)
+        prof.scatter_add_(1, idx.flatten().unsqueeze(0).expand(B, -1), la.mean(1).flatten(1))
+        prof = prof / cnt
+        prof = prof - prof.mean(1, keepdim=True)                  # relative spectral profile (image-adaptive)
+        delta = prof @ self.mod_w_bias.float() + self.mod_b_bias.float()          # (B, nb)
+        g = torch.tanh(self.base_bias.float().view(1, C, self.nb) + delta.unsqueeze(1))   # (B, C, nb), 0 at initialisation
+        gain = torch.exp(g)[:, :, idx]                            # (B, C, H, W/2+1)
+        out = torch.fft.irfft2(torch.polar(amp * gain, pha), s=(H, W), norm="ortho")
+        return out.to(dt)
+
+
+class C3k2SG(C3k2):
+    """C3k2 followed by a SpecGain (phase-preserving spectral amplitude gain, identity at initialisation)."""
+
+    def __init__(self, c1, c2, n=1, c3k=False, e=0.5, attn=False, g=1, shortcut=True):
+        super().__init__(c1, c2, n, c3k, e, attn, g, shortcut)
+        self.sg = SpecGain(c2)
+
+    def forward(self, x):
+        return self.sg(super().forward(x))
+
+
+def _gauss1d(sigma):
+    ks = int(2 * round(3 * sigma) + 1)
+    x = torch.arange(ks, dtype=torch.float32) - ks // 2
+    k = torch.exp(-(x ** 2) / (2 * sigma ** 2))
+    return k / k.sum()
+
+
+class _SepBlur(nn.Module):
+    """Fixed separable Gaussian blur on c channels (reflect padding); the kernel follows the dtype of the input."""
+
+    def __init__(self, c, sigma):
+        super().__init__()
+        self.c = c
+        self.register_buffer("kh", _gauss1d(sigma).view(1, 1, 1, -1).repeat(c, 1, 1, 1))
+
+    def forward(self, x):
+        k = self.kh.to(x.dtype)
+        p = k.shape[-1] // 2
+        x = F.conv2d(F.pad(x, (p, p, 0, 0), mode="reflect"), k, groups=self.c)
+        return F.conv2d(F.pad(x, (0, 0, p, p), mode="reflect"), k.transpose(2, 3), groups=self.c)
+
+
+class UnsharpGate(nn.Module):
+    """x + sum_s k * a_s * (x - G_s x): learned multi-scale local-contrast (detail) gain, a = 0 at initialisation (identity).
+    A positive gain raises the contrast of low-contrast objects relative to their surroundings (counteracts backscatter)."""
+
+    def __init__(self, c=3, sigmas=(1.5, 4.0, 12.0), gain_scale=3.0):
+        super().__init__()
+        self.blurs = nn.ModuleList(_SepBlur(c, s) for s in sigmas)
+        self.gate_bias = nn.Parameter(torch.zeros(len(sigmas) * c))
+        self.k, self.c = gain_scale, c
+
+    def forward(self, x):
+        xf = x.float()
+        a = self.gate_bias.float().view(len(self.blurs), 1, self.c, 1, 1)
+        out = xf
+        for i, b in enumerate(self.blurs):
+            out = out + self.k * a[i] * (xf - b(xf))
+        return out.to(x.dtype)
+
+
+class LCNGate(nn.Module):
+    """Local contrast normalisation blended with the input: x + a * (LCN(x) * s + m - x), LCN(x) = (x - G x) / sqrt(G (x - G x)^2 + eps)."""
+
+    def __init__(self, c=3, sigma=8.0, a0=0.5, m=0.4, s=0.18, eps=1e-3):
+        super().__init__()
+        self.blur = _SepBlur(c, sigma)
+        self.gate_bias = nn.Parameter(torch.full((c,), float(a0)))
+        self.m, self.s, self.eps = m, s, eps
+
+    def forward(self, x):
+        xf = x.float()
+        d = xf - self.blur(xf)
+        y = d / (self.blur(d * d) + self.eps).sqrt() * self.s + self.m
+        a = self.gate_bias.float().view(1, -1, 1, 1)
+        return (xf + a * (y - xf)).to(x.dtype)
+
+
+class ConvUSH0(Conv):
+    """Conv whose input passes through UnsharpGate (identity at initialisation)."""
+
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True):
+        super().__init__(c1, c2, k, s, p, g, d, act)
+        self.ush = UnsharpGate(c1)
+
+    def forward(self, x):
+        return super().forward(self.ush(x))
+
+    def forward_fuse(self, x):
+        return super().forward_fuse(self.ush(x))
+
+
+class ConvLCN0(Conv):
+    """Conv whose input passes through LCNGate (a0 = 0.5)."""
+
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True):
+        super().__init__(c1, c2, k, s, p, g, d, act)
+        self.lcn = LCNGate(c1)
+
+    def forward(self, x):
+        return super().forward(self.lcn(x))
+
+    def forward_fuse(self, x):
+        return super().forward_fuse(self.lcn(x))
+
+
+class AmpMixV2(nn.Module):
+    """AmpMix with options: probability p, lambda ~ U(0, lam_max), and a frequency band: mix only the amplitudes at radial frequency
+    <= band (low band: illumination / colour / contrast) or > band (high band: texture / sharpness), r = 1 at the corner of the spectrum.
+    band = None mixes the whole spectrum (same as AmpMix).  clamp: clip the result to [0, 1] (images, not features)."""
+
+    def __init__(self, p=0.5, lam_max=1.0, band=None, high=False, clamp=True):
+        super().__init__()
+        self.p, self.lam_max, self.band, self.high, self.clamp = p, lam_max, band, high, clamp
+
+    def forward(self, x):
+        if not self.training or x.shape[0] < 2:
+            return x
+        B, _, H, W = x.shape
+        dt = x.dtype
+        f = torch.fft.rfft2(x.float(), norm="ortho")
+        amp, pha = f.abs(), f.angle()
+        perm = torch.randperm(B, device=x.device)
+        lam = torch.rand(B, 1, 1, 1, device=x.device) * self.lam_max
+        lam = lam * (torch.rand(B, 1, 1, 1, device=x.device) < self.p).float()
+        mixed = (1 - lam) * amp + lam * amp[perm]
+        if self.band is not None:
+            fy = torch.fft.fftfreq(H, device=x.device).abs().view(H, 1)
+            fx = torch.fft.rfftfreq(W, device=x.device).view(1, W // 2 + 1)
+            r = (fy ** 2 + fx ** 2).sqrt() / 0.7071
+            m = (r > self.band) if self.high else (r <= self.band)
+            amp = torch.where(m.view(1, 1, H, W // 2 + 1), mixed, amp)
+        else:
+            amp = mixed
+        out = torch.fft.irfft2(torch.polar(amp, pha), s=(H, W), norm="ortho")
+        if self.clamp:
+            out = out.clamp(0, 1)
+        return out.to(dt)
+
+
+class _ConvAmpBase(Conv):
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True, amp_kw=None):
+        super().__init__(c1, c2, k, s, p, g, d, act)
+        self.am = AmpMixV2(**(amp_kw or {}))
+
+    def forward(self, x):
+        return super().forward(self.am(x))
+
+    def forward_fuse(self, x):
+        return super().forward_fuse(self.am(x))
+
+
+class ConvAmpP1(_ConvAmpBase):
+    """AmpMix applied to every training sample (p = 1)."""
+
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True):
+        super().__init__(c1, c2, k, s, p, g, d, act, amp_kw=dict(p=1.0))
+
+
+class ConvAmpLo(_ConvAmpBase):
+    """AmpMix restricted to the low-frequency band (r <= 0.2): illumination / colour / contrast."""
+
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True):
+        super().__init__(c1, c2, k, s, p, g, d, act, amp_kw=dict(band=0.2, high=False))
+
+
+class ConvAmpHi(_ConvAmpBase):
+    """AmpMix restricted to the high-frequency band (r > 0.2): texture / sharpness."""
+
+    def __init__(self, c1, c2, k=1, s=1, p=None, g=1, d=1, act=True):
